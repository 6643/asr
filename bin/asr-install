#!/usr/bin/env bun

import { ensureIbusComponentInstalled } from "../src/runtime/ibus.ts";
import { printTimedError, printTimedLine } from "../src/runtime/output.ts";

const result = await ensureIbusComponentInstalled();
if (!result.ok) {
    printTimedError(result.error.message);
    process.exit(1);
}

printTimedLine(result.value);
